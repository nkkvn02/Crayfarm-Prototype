{
  "functions": [
    {
      "source": "functions",
      "codebase": "crayfarm-admin",
      "predeploy": [
        "node scripts/block-deploy.mjs",
        "npm --prefix functions run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "predeploy": [
      "node scripts/block-deploy.mjs"
    ]
  },
  "database": {
    "rules": "database.emulator.rules.json",
    "predeploy": [
      "node scripts/block-deploy.mjs"
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
